PORT=3001
REDIS_URL=redis://localhost:6379
PUBLIC_SALT=ronin-rush-public-salt-v1
GROWTH_K=0.00006
BETTING_MS=8000
RESULT_MS=3000
# Dev only: fixed terminal seed so the chain (and every crash point) is reproducible.
CHAIN_TERMINAL_SEED=a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1
CHAIN_LENGTH=100000
DATABASE_URL=postgres://ronin:ronin@localhost:5432/ronin
MIGRATE_ON_BOOT=true
SIGNUP_GRANT_CENTS=100000
REDIS_NAMESPACE=ronin
# Optional error tracking
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
# Kafka (empty = outbox dry-run). The API also reads its topics back for the System view.
KAFKA_BROKERS=
KAFKA_CONSUMER_ENABLED=true
KAFKA_PARTITIONS=3
# PLATFORM_MODE=true: identity, wallet and responsible gaming in platform-core (docs/platform-mode.md)
PLATFORM_MODE=false
PLATFORM_CORE_URL=
PLATFORM_JWKS_URL=
PLATFORM_JWT_ISSUER=
PLATFORM_JWT_AUDIENCE=platform-core
PLATFORM_CLIENT_ID=
PLATFORM_CLIENT_SECRET=
PLATFORM_HOUSE_ACCOUNT_ID=
PLATFORM_CURRENCY=EUR
