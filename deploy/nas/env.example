# /volume1/docker/ronin-rush/.env — secrets live only on the NAS (chmod 600), never in git.
# init.sh creates this file with random secrets; edit only the non-secret values below.

# Image tag currently deployed (git short SHA). deploy.sh updates it.
RONIN_TAG=

POSTGRES_PASSWORD=
JWT_SECRET=

# Kafka: empty = outbox dry-run (events still shown in the System view).
#   127.0.0.1:9092 → own broker (deploy.sh then adds --profile kafka)
#   PLATFORM_KAFKA=true is not supported on this NAS (shared network namespace)
KAFKA_BROKERS=
PLATFORM_KAFKA=false
PLATFORM_NETWORK=platform-staging_default
KAFKA_CLIENT_ID=ronin-rush-nas

# Public origin (Tailscale Funnel) and who may embed the game in an iframe ('self' is always allowed).
CORS_ORIGIN=https://magnum-play.tail55a5b1.ts.net:10000
FRAME_ANCESTORS=https://danielgil.eu https://www.danielgil.eu

# Game tuning for the demo
BOTS_COUNT=10
CHAIN_LENGTH=100000
SIGNUP_GRANT_CENTS=100000

# Optional error tracking
SENTRY_DSN=
SENTRY_ENVIRONMENT=nas
