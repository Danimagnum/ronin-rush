# Rendered by the nginx image's envsubst step (only ${VARS} defined in the environment are replaced).
# One origin for everything, so the browser never needs CORS and the iframe talks to its own host.

map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

upstream ronin_api {
  # Several entries = several API instances; Socket.IO needs sticky sessions only for long-polling,
  # and the client is WebSocket-first, but ip_hash keeps polling fallbacks on one instance too.
  ip_hash;
  server ${API_UPSTREAM} max_fails=3 fail_timeout=5s;
}

upstream ronin_web {
  server ${WEB_UPSTREAM};
}

server {
  # LISTEN_PORT (default 8080): configurable for stacks that share one network namespace.
  listen ${LISTEN_PORT};
  server_name _;
  server_tokens off;
  client_max_body_size 64k;

  # Tailscale Funnel terminates TLS and forwards the visitor's address.
  set_real_ip_from 127.0.0.1;
  set_real_ip_from 100.64.0.0/10;
  set_real_ip_from 172.16.0.0/12;
  real_ip_header X-Forwarded-For;
  real_ip_recursive on;

  # Embeddable only from the portfolio (and itself). Everything else may not frame it.
  add_header Content-Security-Policy "frame-ancestors 'self' ${FRAME_ANCESTORS}" always;
  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;

  location = /nginx-health {
    access_log off;
    return 200 "ok\n";
  }

  location /socket.io/ {
    proxy_pass http://ronin_api;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 75s;
    proxy_send_timeout 75s;
    proxy_buffering off;
  }

  location /api/ {
    proxy_pass http://ronin_api;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
  }

  location = /health {
    proxy_pass http://ronin_api;
    access_log off;
  }

  # Hashed build assets never change: cache for a year.
  location /_next/static/ {
    proxy_pass http://ronin_web;
    add_header Cache-Control "public, max-age=31536000, immutable";
    add_header Content-Security-Policy "frame-ancestors 'self' ${FRAME_ANCESTORS}" always;
  }

  location / {
    proxy_pass http://ronin_web;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
  }
}
