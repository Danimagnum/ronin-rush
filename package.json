{
  "name": "ronin-rush",
  "private": true,
  "version": "0.1.0",
  "description": "Live shared-round crash game with provable fairness, server-authoritative timing and a double-entry ledger. Play money only.",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm --filter \"./packages/*\" --filter \"./apps/*\" test",
    "typecheck": "pnpm --filter @ronin/shared build && pnpm -r typecheck",
    "dev:api": "pnpm --filter @ronin/shared build && pnpm --filter @ronin/api dev",
    "dev:web": "pnpm --filter @ronin/shared build && pnpm --filter @ronin/web dev",
    "test:e2e": "pnpm --filter @ronin/e2e test",
    "load": "k6 run load/players.k6.js"
  }
}
