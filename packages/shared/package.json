{
  "name": "@ronin/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pure, isomorphic code shared by the API and the browser: provably-fair functions, multiplier curve, schemas.",
  "main": "./dist/cjs/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.build.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', '{\\\"type\\\":\\\"commonjs\\\"}')\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "~5.7.3",
    "vitest": "^3.0.5"
  },
  "module": "./dist/esm/index.js",
  "dependencies": {
    "zod": "^3.24.2"
  }
}
